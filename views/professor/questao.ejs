<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--========== BOX ICONS ==========-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">

    <!--========== CSS ==========-->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Responsive sidebar submenus</title>
    <link rel="stylesheet" href="/css/editor.css">


    <!-- Enhanced CSS for .resposta-item -->
    <style>
        .main{
            display: grid;
        }
    </style>


</head>

<body>

    <%- include('../partials/sidebar') %>
        <main>
            <div class="container">

                <h1>Registrar Nova Questão</h1>
                <form action="/professor/registrar-questao/<%= tipo %>" method="POST">
                    <div class="titulo">
                        <label for="titulo">TITULO:</label>
                        <input type="text" id="titulo" name="titulo" required>
                    </div>





                    <input type="file" id="upload" hidden />

                    <div id="parentEditor">
                        <%- include('../partials/painel') %>

                            <div id="editor" contenteditable="true">
                                Olá, mundo!!
                            </div>
                    </div>
                    <% if ( tipo==="objetiva" ) { %>
                        <div id="respostas-container">
                            <span> Adicione as alternativas e selecione apenas a(s) resposta(s) correta(s)</span>
                            <div class="resposta-item">
                                <input type="checkbox" name="correta[]" value="true">
                                <input type="text" name="respostas[]" placeholder="Sua resposta">

                                <button class="remove-button" type="button" onclick="removeResposta(this)">Remover
                                    resposta</button>
                            </div>
                        </div>
                        <button type="button" onclick="addResposta()">Adicionar resposta</button>

                        <% } else { %>
                            <label for="descricao">Resposta :</label>
                            <textarea id="descricao" name="resposta" rows="5" cols="50" required> </textarea>
                            <% } %>
                                <input type="hidden" id="respostasSelecionadas" name="respostasSelecionadas">
                                <div style=" margin-left: 10.5rem;">
                                    <input type="hidden" id="pergunta" name="pergunta">

                                    <div>
                                    <label for="areaId">Selecione uma área:</label>
                                    <select name="areaId" id="areaId" onchange="updateTopicos(<%= JSON.stringify(Areas) %>)">
                                        <% Areas.forEach(area=> { %>
                                            <option value="<%= area.id %>">
                                                <%= area.area %>
                                            </option>
                                            <% }); %>
                                    </select>
                                    </div>
                                    <div>
                                    <label for="topicosLista">Selecione os tópicos:</label>
                                    <div id="topicosLista" class="topicos-lista">
                                        <!-- Os checkboxes de tópicos serão adicionados dinamicamente aqui -->
                                    </div>

                                    </div>


                                </div>
                                <div style=" margin-left: 4rem;">
                                    <label for="simuladoId">Selecione um simulado (Opcional):</label>
                                    <select name="simuladoId" id="simuladoId">
                                        <option value="" selected>Nenhum</option>
                                        <% simulados.forEach(simulado=> { %>
                                            <option value="<%= simulado.id %>">
                                                <%= simulado.titulo %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>


                                <button type="submit">Registrar</button>
                </form>

            </div>
            </div>
        </main>


        <script>
            function updateTopicos(Areas) {
                // Obter o elemento select da área
                const areaSelect = document.getElementById('areaId');
        
                // Obter o valor selecionado da área
                const selectedAreaId = areaSelect.value;
        
                // Obter os tópicos correspondentes à área selecionada
                const selectedArea = Areas.find(area => area.id === parseInt(selectedAreaId));
                const topicos = selectedArea ? selectedArea.Topico : [];
        
                // Obter o elemento container de tópicos
                const topicosContainer = document.getElementById('topicosLista');
        
                // Limpar as opções de tópicos
                topicosContainer.innerHTML = '';
        
                // Adicionar as opções de tópicos ao container
                topicos.forEach(topico => {
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.name = 'topicoId';
                    checkbox.value = topico.id;
                    checkbox.id = 'topico-' + topico.id;
        
                    const label = document.createElement('label');
                    label.htmlFor = 'topico-' + topico.id;
                    label.textContent = topico.materia;
        
                    topicosContainer.appendChild(checkbox);
                    topicosContainer.appendChild(label);
                    topicosContainer.appendChild(document.createElement('br')); // Add a line break for better readability
                });
            }
        </script>



        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var editor = document.getElementById('editor');
                var perguntaInput = document.getElementById('pergunta');



                editor.addEventListener('input', function () {
                    var perguntaTexto = editor.innerHTML.trim().replace(/\s+/g, ' ');
                    perguntaInput.value = perguntaTexto;
                    console.log(perguntaInput.value)
                });
            });
        </script>
        <!--========== MAIN JS ==========-->
        <script src="/js/main.js"></script>
        <script src="/js/editor.js"></script>
        <script src="/js/jscolor.min.js"></script>
</body>

</html>