<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <!--========== BOX ICONS ==========-->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">

        <!--========== CSS ==========-->
        <link rel="stylesheet" href="/css/styles.css">

        <title>Responsive sidebar submenus</title>

        <style>
            * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            background-color: #f5f5f5;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Estilos do cabeçalho */
        header {
            background-color: #333;
            color: #fff;
            padding: 10px;
        }
        
        /* Estilos da barra lateral */
        .sidebar {
            width: 250px;
            background-color: #444;
            color: #fff;
            position: fixed;
            left: 0;
            top: 0;
            height: 100%;
            overflow-y: auto;
        }
        
        .sidebar h2 {
            padding: 10px;
        }
        
        .sidebar ul {
            list-style-type: none;
            padding: 0;
        }
        
        .sidebar li {
            padding: 10px;
            border-bottom: 1px solid #666;
        }
        
        /* Estilos do conteúdo principal */
        .main-content {
            margin: 0 auto; /* Centraliza o conteúdo principal */
            max-width: 800px; /* Define a largura máxima do conteúdo */
            padding: 20px;
        }
        
        .main-content h1 {
            margin-bottom: 20px;
        }
        
        /* Estilos da tabela */
        .table-container {
            overflow-x: auto;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        table th,
        table td {
            padding: 10px;
            border: 1px solid #ccc;
        }
        
        /* Estilos da paginação */
        .pagination-container {
            margin-top: 20px;
            text-align: center; /* Centraliza a paginação */
        }
        
        .pagination-container a {
            display: inline-block;
            padding: 8px 16px;
            margin-right: 5px;
            background-color: #ccc;
            color: #333;
            text-decoration: none;
            border-radius: 5px;
        }
        
        .pagination-container a.active {
            background-color: #333;
            color: #fff;
        }
        
        /* Estilos do formulário */
        form {
            margin-bottom: 20px;
            text-align: center; /* Centraliza o formulário */
        }
        form select,
        form input[type="text"],
        form button,
        form input[type="submit"] {
            padding: 10px;
            margin-right: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        
        form input[type="checkbox"] {
            margin-right: 5px;
        }
        
        /* Estilos do link de voltar */
        .back-link {
            display: block;
            margin-top: 20px;
            color: #333;
            text-decoration: none;
            border-bottom: 1px solid #333;
            padding-bottom: 5px;
        }
        .botao-associar{
            padding: 10px 20px;
            width: 20%;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 14px;
            margin-top: 10px;
        
            justify-self: center;
            border: 1px solid #272525;
        }
        
        
        /* Estilos responsivos */
        @media screen and (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                margin-bottom: 20px;
            }
        
            .main-content {
                margin-left: 0;
                max-width: none; /* Remove a largura máxima no modo responsivo */
            }
        
            .pagination-container {
                text-align: center;
            }
        
            form {
                text-align: center;
            }
        }
        </style>
    </head>
    <body>
        <%- include('../partials/sidebar') %>
        <!--========== CONTENTS ==========-->
        <main >
    
            <h1><%=simulado.titulo %></h1>

            <h1>Associar questoes</h1>
            <form action="/usuario/simulados/<%= simulado.id %>/adicionar-questoes" method="GET">
                <!-- Campo de filtragem por título -->
                <input type="text" name="titulo" placeholder="Filtrar por título">
                <button type="submit">Pesquisar</button>
            
                <!-- Campo de seleção para áreas -->
                <select name="areaId">
                    <option value="">Todas as áreas</option>
                    <% Areas.forEach(area => { %>
                        <option value="<%= area.id %>"><%= area.area %></option>
                    <% }); %>
                </select>
                <button type="submit">Filtrar por área</button>

                 <!-- Campo de seleção para tópicos -->
                <select name="topicosSelecionados">
                    <option value="">Todas os tópicos</option>
                    <% topicos.forEach(topico => { %>
                        <option value="<%= topico.id %>"><%= topico.materia %></option>
                    <% }); %>
                </select>
                <button type="submit">Filtrar por tópicos</button>
            </form>
           
            <form action="/usuario/simulados/<%= simulado.id %>/adicionar-questoes" method="POST">
                <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Título</th>
                            <th>Questão</th>
                            <th>Tipo</th>
                            <th>Área</th>
                            <th>Tópico</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        <% questoes.forEach(questao => { %>
                            <tr>
                                <td>
                                    <input type="checkbox" id="questao-<%= questao.id %>" name="questoesSelecionadas" value="<%= questao.id %>">
                                </td>
                                <td><%= questao.titulo %></td>
                                <td><%= questao.pergunta %></td>
                                <td><%= questao.tipo %></td>
                                <td><%= questao.areaId %></td>
                                <td>
                                    <% questao.Topicos.forEach(topico => { %>
                                        <%= topico.materia %>
                                    <% }); %>
                                </td>
                                
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
            
                <div class="pagination-container">
                    <% if (page > 1) { %>
                        <a href="/usuario/simulados/<%= simulado.id %>/adicionar-questoes?page=<%= page - 1 %>">Anterior</a>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <a href="/usuario/simulados/<%= simulado.id %>/adicionar-questoes?page=<%= i %>" class="<%= page === i ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                    <% if (page < totalPages) { %>
                        <a href="/usuario/simulados/<%= simulado.id %>/adicionar-questoes?page=<%= page + 1 %>">Próximo</a>
                    <% } %>
                    
                </div>
                <button type="submit" class="botao-associar">Associar Questões</button>
                <input type="hidden" name="simuladoId" value="<%= simulado.id %>">


  
            </form>
          
              
    <link rel="stylesheet" href="/css/styles.css">
        </main>

        <!--========== MAIN JS ==========-->
        <script src="/js/main.js"></script>
    </body>
</html>