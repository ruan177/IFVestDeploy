<!DOCTYPE html>
<html lang="en">
<head>
    <title>Prova</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!--========== BOX ICONS ==========-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">

    <!--========== CSS ==========-->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/googlef2.css">
    <link rel="stylesheet" href="/css/textarea.css">

    <title>Realização de provas</title>
</head>
<body>
    <%- include('../partials/sidebar') %>
    <main>
        <form id="questionarioDissertativa" class="form" action="/usuario/simulados/responder-prova/<%= prova.id %>" method="POST">  
            <div class="title-div">
                <h1>Teste de questões <%= tipo %></h1>
            </div>
            <% if (tipo === "DISSERTATIVO") { %>
                <% perguntas.forEach(pergunta => { %>
                    <div class="name-div">
                        <div class="titulo"><p><%= pergunta.titulo %></p></div>
                        <div class="name"><%- pergunta.pergunta %><span class="required">*</span></div>
                        <div class="input-div"><textarea name="respostas[]" placeholder="Sua resposta"></textarea></div>
                    </div>
                <% }) %>
            <% } else if (tipo === "OBJETIVO") { %>
                <% perguntas.forEach(pergunta => { %>
                    <div class="name-div">
                        <div class="titulo"><p><%= pergunta.titulo %></p></div>
                        <div class="name"><%- pergunta.pergunta %><span class="required">*</span></div>
                        <div class="input-div">
                            <% if (pergunta.resposta) { %>
                                <% pergunta.resposta.split('_').forEach((resposta, index) => { %>
                                    <input type="radio" id="resposta<%= index %>" name="resposta[<%= index %>]" value="<%= resposta %>">
                                    <label for="resposta<%= index %>"><%= resposta %></label><br>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } %>
            <div class="espaco">
                <button class="btn" type="submit">Enviar</button>
            </div>
        </form>
    </main>
    
     <!--========== MAIN JS ==========-->
    <script src="/js/main.js"></script>
    <script src="/js/prova.js"></script>
</body>
</html>